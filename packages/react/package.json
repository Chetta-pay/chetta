{
  "name": "@chettapay/react",
  "version": "0.11.3",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Chetta-pay/chetta.git",
    "directory": "packages/react"
  },
  "description": "React bindings for ChettaPay: authentication UI, transaction modals and hooks for Stellar and Solana applications",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./styles.css": "./dist/index.css"
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "tsc --noEmit && eslint src",
    "clean": "rm -rf dist"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@chettapay/core": "^0.11.3",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^13.3.0",
    "qr.js": "^0.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@chettapay/core": "^0.11.3",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "eslint": "^10.5.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0"
  }
}
